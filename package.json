{
  "name": "photo-viewer-3d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "tsx scripts/serve-static.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test --test-timeout=30000 tests/*.test.ts",
    "test:browser": "playwright test",
    "photo-watch": "tsx scripts/photo-import-watcher.ts",
    "backend": "node --conditions=react-server --import tsx scripts/local-photo-server.ts"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "exifr": "7.1.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
