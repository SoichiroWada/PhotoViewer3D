{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "aws-lambda"],
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["bin/**/*.ts", "scripts/**/*.ts", "lib/**/*.ts", "lambda/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "cdk.out"]
}
