# Absolute server-side path; files are never copied into public/.
PHOTO_DIRECTORY=/path/to/your/photos
PHOTO_INCOMING_DIRECTORY=/path/to/your/incoming/photos

# Optional: absolute path outside PHOTO_DIRECTORY. Defaults to .photo-cache/
# inside the application directory; variants are generated only on demand.
# PHOTO_CACHE_DIRECTORY=/path/to/your/photo-cache

# Optional importer controls (defaults shown).
PHOTO_IMPORT_CONCURRENCY=4
PHOTO_IMPORT_STABILITY_MS=3000
PHOTO_IMPORT_POLL_MS=250